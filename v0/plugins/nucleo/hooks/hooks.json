{
  "description": "Núcleo: proteção de segredos, comandos destrutivos, teto de custo e defesa contra prompt injection",
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/estado_sessao.py\""}]}
    ],
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guarda_bash.py\""}]},
      {"matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep", "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guarda_arquivos.py\""}]},
      {"matcher": "*", "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/orcamento.py\""}]}
    ],
    "PostToolUse": [
      {"matcher": "WebFetch|WebSearch|mcp__.*", "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/conteudo_externo.py\""}]}
    ]
  }
}
